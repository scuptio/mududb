#!/bin/sh
set -e

# The repository has no root cargo workspace: crates/{common,db-kernel,sdk,
# tools} and example/mpk are independent workspaces, checked one at a time.
GROUPS="crates/common crates/db-kernel crates/sdk example/mpk crates/tools"
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

echo "Running cargo fmt --check (per group workspace)..."

for group in $GROUPS; do
    echo "  [fmt] $group"
    if ! (cd "$REPO_ROOT/$group" && cargo fmt -- --check) 2>&1; then
        echo ""
        echo "Formatting check failed in $group. Run 'cargo fmt' and try again."
        exit 1
    fi
done

echo "Formatting check passed."
echo ""
echo "Running cargo clippy --workspace --all-targets (per group workspace)..."

for group in $GROUPS; do
    echo "  [clippy] $group"
    if ! (cd "$REPO_ROOT/$group" && cargo clippy --workspace --all-targets -- -D warnings) 2>&1; then
        echo ""
        echo "Clippy check failed in $group. Commit aborted."
        exit 1
    fi
done

echo "Clippy check passed."
echo ""
echo "Running cargo deny check bans licenses advisories sources (per group workspace)..."

for group in $GROUPS; do
    echo "  [deny] $group"
    if ! (cd "$REPO_ROOT/$group" && cargo deny check --config "$REPO_ROOT/deny.toml" bans licenses advisories sources) 2>&1; then
        echo ""
        echo "Cargo deny check failed in $group. Commit aborted."
        exit 1
    fi
done

echo "Cargo deny check passed."
