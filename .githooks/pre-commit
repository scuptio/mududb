#!/bin/sh
# Fast pre-commit gate: fmt + clippy + cargo deny per group workspace, then a
# verification drift gate for formally verified sources.
# The checks live in script/ci/check_all.py (single source of truth, shared
# with `cargo make check`); this wrapper only selects the fast steps so the
# hook stays quick. Run the full suite with: cargo make check
set -e

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ -n "${PYTHON:-}" ]; then
    :
elif command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
else
    PYTHON=python
fi

"$PYTHON" "$REPO_ROOT/script/ci/check_all.py" --only fmt,clippy,deny --fail-fast

# Verification drift gate: when staged changes touch sources covered by
# verification/targets.toml, re-extract them and require the committed
# generated Lean to be current (no proof build). Silently skipped when the
# formal toolchain is not installed (cargo make doctor -- install --only
# formal-verification); Linux x86_64 only.
"$PYTHON" "$REPO_ROOT/script/verification/check.py" drift --staged --skip-if-no-tools
