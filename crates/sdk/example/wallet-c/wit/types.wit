// Project message types for the wallet-c guest: user-defined procedure
// types declared in WIT, consumed two ways from the same file:
//
//   - `mgen message -i wit/types.wit -o gentypes/Types.h -l c` generates
//     the C structs plus their xxx_encode/xxx_decode codecs — see the
//     Makefile `gentypes` task;
//   - `mtp ... --type-wit wit/types.wit` registers these names so procedure
//     signatures in src/procedures.c may use them (record
//     parameters/returns) — see the Makefile `transpile` task.
//
// On the procedure byte pipe a record travels as the positional
// `uni-data-value` record case (declaration order, names dropped by the
// host); the desc JSON keys are the WIT field names verbatim. The guest
// decodes/encodes through the binding's record bridge
// (`mududb/codec/record_bridge.h`) composed with the generated codecs.
//
// The `package` clause matches world.wit: one WIT directory is one package,
// and the world build (`wasm-tools component embed wit/`) rejects
// headerless files sitting next to a packaged world. The world does not
// reference this interface; it rides along inertly.
package mududb:wallet-c;

interface wallet-types {
    // A flat nested record: two plain string fields.
    record address {
        city: string,
        zip: string,
    }

    // The wallet user profile: scalar fields (u32 and bool both cross the
    // host as i32 — bool as 0/1), a list field, and a nested optional
    // record. Keep the option field LAST: the wire form is positional, and
    // an omitted trailing option is the only omission a positional record
    // can express unambiguously.
    record profile {
        display-name: string,
        level: u32,
        vip: bool,
        tags: list<string>,
        home: option<address>,
    }
}
