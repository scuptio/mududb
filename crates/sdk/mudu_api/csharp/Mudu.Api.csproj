<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>mududb</RootNamespace>
    <AssemblyName>mududb</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Keep available XML docs, without requiring full documentation of generated
         interop/DTO members. Set EnforceCompleteXmlDocumentation=true to audit coverage. -->
    <NoWarn Condition="'$(EnforceCompleteXmlDocumentation)' != 'true'">$(NoWarn);CS1591</NoWarn>
    <PackageId>mududb</PackageId>
    <Version>0.1.0</Version>
    <Authors>mududb</Authors>
    <Description>C# bindings for MuduDB: syscall API, universal DTOs and MSSP frame codec, with a SQLite-backed mock backend</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/scuptio/mududb</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Exported snapshots have no original Git tree or matching source paths.
       Embed their sources in symbols instead of emitting invalid SourceLink data. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/sdk-source.json')">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="examples\**\*.cs" />
    <Compile Remove="demo\**\*.cs" />
    <EmbeddedResource Remove="demo\**\*" />
    <None Remove="demo\**\*" />
    <Compile Remove="Mudu.Api.Tests\**\*.cs" />
    <EmbeddedResource Remove="Mudu.Api.Tests\**\*" />
    <None Remove="Mudu.Api.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="mudu_sys\ApiWorld_component_type.wit" Pack="false" Visible="true" />
  </ItemGroup>
</Project>
