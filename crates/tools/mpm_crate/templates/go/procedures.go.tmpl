package main

import (
	"sort"

	gentypes "{{module_name}}/gentypes"
)

// {{project_name}} business logic: every procedure takes the session OID
// from the procedure parameter and returns a `(T, error)` pair. SQL goes
// through the syscall layer in mudusys.go, which frames SyscallPayload v1
// (MSSP) messages over the `mududb:api/system` byte pipe, typed per table
// through the mgen-generated entity files (<table>.go, package main — row
// struct, row codec and typed SQL helpers; regenerated by `cargo make
// generate` from sql/ddl.sql, never edit by hand).
//
// To add a procedure: write a func with a `// mudu-proc` comment immediately
// above it (first parameter the `muduOid` session, result `(T, error)`) and
// rebuild — mtp regenerates the Exports wiring (main_gen.go), the world WIT
// and the procedure descriptor. Parameter and result types: `int64`,
// `string`, `float64`, `bool`, `[]byte`, and the user-defined record types
// declared in wit/types.wit (generated into the gentypes package by
// `cargo make gentypes`; see readme.md).

// mudu-proc
func createItem(session muduOid, itemID int64, name string) (int64, error) {
	quantity := int64(0)
	row := ItemsRow{ItemId: itemID, Name: &name, Quantity: &quantity}
	inserted, err := row.Insert(session)
	if err != nil {
		return 0, err
	}
	if inserted != 1 {
		return 0, &domainError{errCodeDomainViolation, "create item failed"}
	}
	return itemID, nil
}

// updateItemInfo stores a user-defined record argument and returns the
// stored record. The `item-info` record type is declared in wit/types.wit
// and generated into the gentypes package by mgen; the mtp adapter decodes
// the positional record envelope through the binding bridge
// (types.RecordFieldValues) composed with gentypes.ItemInfoFromValue, and
// encodes the returned record symmetrically.
//
// Storage design: the record flattens into the `item_info` table columns
// (bool/u32 as INT — the host carries both as i32); the label list lands in
// the `item_info_labels` side table keyed by (item_id, idx) — the engine
// requires a complete key for DELETE and has no ORDER BY, so
// queryItemInfo re-sorts by idx in Go.
//
// mudu-proc
func updateItemInfo(session muduOid, itemID int64, info gentypes.ItemInfo) (gentypes.ItemInfo, error) {
	inStock := int64(0)
	if info.InStock {
		inStock = 1
	}
	updated, err := sysCommand(session,
		"UPDATE item_info SET name = ?, price = ?, in_stock = ? WHERE item_id = ?",
		info.Name, int64(info.Price), inStock, itemID)
	if err != nil {
		return gentypes.ItemInfo{}, err
	}
	if updated == 0 {
		inserted, err := sysCommand(session,
			"INSERT INTO item_info (item_id, name, price, in_stock) VALUES (?, ?, ?, ?)",
			itemID, info.Name, int64(info.Price), inStock)
		if err != nil {
			return gentypes.ItemInfo{}, err
		}
		if inserted != 1 {
			return gentypes.ItemInfo{}, &domainError{errCodeDomainViolation, "insert item info failed"}
		}
	}
	// The engine requires a complete primary key for DELETE, so the old
	// labels are first read by the key-prefix predicate and then deleted one
	// by one.
	oldLabels, err := sysQuery(session,
		"SELECT idx, label FROM item_info_labels WHERE item_id = ?", itemID)
	if err != nil {
		return gentypes.ItemInfo{}, err
	}
	for _, row := range oldLabels {
		if len(row) == 0 {
			return gentypes.ItemInfo{}, &domainError{errCodeInternal, "item label row shape mismatch"}
		}
		idx, ok := row[0].(int64)
		if !ok {
			return gentypes.ItemInfo{}, &domainError{errCodeInternal, "item label idx is not an i64"}
		}
		deleted, err := sysCommand(session,
			"DELETE FROM item_info_labels WHERE item_id = ? AND idx = ?", itemID, idx)
		if err != nil {
			return gentypes.ItemInfo{}, err
		}
		if deleted != 1 {
			return gentypes.ItemInfo{}, &domainError{errCodeDomainViolation, "delete item label failed"}
		}
	}
	for i, label := range info.Labels {
		inserted, err := sysCommand(session,
			"INSERT INTO item_info_labels (item_id, idx, label) VALUES (?, ?, ?)",
			itemID, int64(i), label)
		if err != nil {
			return gentypes.ItemInfo{}, err
		}
		if inserted != 1 {
			return gentypes.ItemInfo{}, &domainError{errCodeDomainViolation, "insert item label failed"}
		}
	}
	return queryItemInfo(session, itemID)
}

// queryItemInfo rebuilds the stored item-info record: the flat columns and
// the side-table labels re-sorted by idx.
func queryItemInfo(session muduOid, itemID int64) (gentypes.ItemInfo, error) {
	rows, err := sysQuery(session,
		"SELECT name, price, in_stock FROM item_info WHERE item_id = ?", itemID)
	if err != nil {
		return gentypes.ItemInfo{}, err
	}
	if len(rows) == 0 {
		return gentypes.ItemInfo{}, &domainError{errCodeEntityNotFound, "item info not found"}
	}
	row := rows[0]
	if len(row) != 3 {
		return gentypes.ItemInfo{}, &domainError{errCodeInternal, "item info row shape mismatch"}
	}
	name, ok := row[0].(string)
	if !ok {
		return gentypes.ItemInfo{}, &domainError{errCodeInternal, "item info name is not a string"}
	}
	price, ok := row[1].(int64)
	if !ok {
		return gentypes.ItemInfo{}, &domainError{errCodeInternal, "item info price is not an i64"}
	}
	inStock, ok := row[2].(int64)
	if !ok {
		return gentypes.ItemInfo{}, &domainError{errCodeInternal, "item info in_stock is not an i64"}
	}

	labelRows, err := sysQuery(session,
		"SELECT idx, label FROM item_info_labels WHERE item_id = ?", itemID)
	if err != nil {
		return gentypes.ItemInfo{}, err
	}
	sort.Slice(labelRows, func(i, j int) bool {
		left, leftOk := labelRows[i][0].(int64)
		right, rightOk := labelRows[j][0].(int64)
		return leftOk && rightOk && left < right
	})
	labels := make([]string, 0, len(labelRows))
	for _, labelRow := range labelRows {
		if len(labelRow) != 2 {
			return gentypes.ItemInfo{}, &domainError{errCodeInternal, "item label row shape mismatch"}
		}
		label, ok := labelRow[1].(string)
		if !ok {
			return gentypes.ItemInfo{}, &domainError{errCodeInternal, "item label is not a string"}
		}
		labels = append(labels, label)
	}

	return gentypes.ItemInfo{
		Name:    name,
		Price:   uint32(price),
		InStock: inStock != 0,
		Labels:  labels,
	}, nil
}

// Numeric mirrors of the host's `mudu::error::ErrorCode` discriminants
// carried in the `UniError` result arm.
const (
	errCodeEntityNotFound  uint32 = 50009
	errCodeDomainViolation uint32 = 50017
	errCodeInvalidArgument uint32 = 50029
	errCodeInternal        uint32 = 50000
)

// domainError is a domain error raised by a procedure; the byte-pipe
// dispatcher encodes it as the `{1: UniError}` arm of the procedure result.
type domainError struct {
	code    uint32
	message string
}

func (e *domainError) Error() string { return e.message }
