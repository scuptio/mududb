/*
 * {{project_name}} business logic: every procedure takes the session OID
 * from the procedure parameter and returns one datum. SQL goes through
 * `mudu_sys` (MSSP framing) over the `mududb:api/system` byte pipe, typed
 * per table through the mgen-generated entity headers
 * (`generated/entity/<table>.h` — row struct, row/datum codecs and typed
 * SQL helpers; regenerated by `cargo make generate` from sql/ddl.sql,
 * never edit by hand). update_item_info demonstrates a user-defined record
 * type (wit/types.wit, generated into gentypes/Types.h by mgen) as a
 * procedure parameter and return type, decoded/encoded through the
 * binding's record bridge (`mududb/codec/record_bridge.h`) composed with
 * the generated codecs.
 *
 * To add a procedure: write a non-static `mudu_proc_fn`-shaped function with
 * a `// mudu-proc (name: type, ...) -> type` comment immediately above it
 * and rebuild — mtp regenerates the `mp2-*` export wrappers (with their
 * arity/kind check preambles), the world WIT and the procedure descriptor
 * (see readme.md). Annotation types: `i64`, `f64`, `string`, `option<T>`
 * for nullable parameters, and the user-defined record/enum type names
 * registered via `mtp --type-wit wit/types.wit` — the `mudu_datum` support
 * surface of `mudu_sys.h` (`MUDU_DATUM_RECORD` for records,
 * `MUDU_DATUM_I64` ordinals for enums).
 */
#include "items.h"
#include "mudu_sys.h"

#include <string.h>

#include "gentypes/Types.h"
#include "mududb/codec/record_bridge.h"

// mudu-proc (item_id: i64, name: string) -> i64
int create_item(const mudu_proc_param *param, mudu_datum *result, mudu_error *err) {
    {
        items_row row;
        uint64_t affected = 0;
        items_row_init(&row);
        row.item_id = param->params[0].i64;
        row.name = mudu_string_from(param->params[1].str, param->params[1].str_len);
        row.name_is_null = false;
        row.quantity = 0;
        row.quantity_is_null = false;
        if (items_insert(param->session, &row, &affected, err) != 0) {
            return -1;
        }
        if (affected != 1) {
            mudu_error_set(err, MUDU_EC_DOMAIN_VIOLATION, "create item failed");
            return -1;
        }
        *result = mudu_i64(row.item_id);
        return 0;
    }
}

/* ---- update_item_info: a user-defined record type end to end ---- */

/* Store the decoded item-info record: the record flattens into the
 * `item_info` table columns (bool/u32 as INT — the host carries both as
 * i32); the label list lands in the `item_info_labels` side table keyed by
 * (item_id, idx). */
static int store_item_info(mudu_oid session, int64_t item_id, const item_info *info,
                           mudu_error *err) {
    mudu_datum args[4];
    mudu_rows old_labels;
    uint64_t affected = 0;
    uint32_t i;
    args[0] = mudu_str(info->name.data, info->name.len);
    args[1] = mudu_i64((int64_t)info->price);
    args[2] = mudu_i64(info->in_stock ? 1 : 0);
    args[3] = mudu_i64(item_id);
    if (mudu_command(session,
                     "UPDATE item_info SET name = ?, price = ?, in_stock = ? WHERE item_id = ?",
                     args, 4, &affected, err)
        != 0) {
        return -1;
    }
    if (affected == 0) {
        args[0] = mudu_i64(item_id);
        args[1] = mudu_str(info->name.data, info->name.len);
        args[2] = mudu_i64((int64_t)info->price);
        args[3] = mudu_i64(info->in_stock ? 1 : 0);
        if (mudu_command(session,
                         "INSERT INTO item_info (item_id, name, price, in_stock) VALUES (?, ?, ?, ?)",
                         args, 4, &affected, err)
            != 0) {
            return -1;
        }
        if (affected != 1) {
            mudu_error_set(err, MUDU_EC_DOMAIN_VIOLATION, "insert item info failed");
            return -1;
        }
    }
    /* The engine requires a complete primary key for DELETE, so the old
     * labels are first read by the key-prefix predicate and then deleted
     * one by one. */
    args[0] = mudu_i64(item_id);
    if (mudu_query(session, "SELECT idx, label FROM item_info_labels WHERE item_id = ?", args, 1,
                   &old_labels, err)
        != 0) {
        return -1;
    }
    for (i = 0; i < old_labels.n_rows; i++) {
        mudu_datum del_args[2];
        if (old_labels.rows[i].n_fields == 0
            || old_labels.rows[i].fields[0].kind != MUDU_DATUM_I64) {
            mudu_error_set(err, MUDU_EC_INTERNAL, "item label idx is not an i64");
            return -1;
        }
        del_args[0] = mudu_i64(item_id);
        del_args[1] = old_labels.rows[i].fields[0];
        if (mudu_command(session, "DELETE FROM item_info_labels WHERE item_id = ? AND idx = ?",
                         del_args, 2, &affected, err)
            != 0) {
            return -1;
        }
        if (affected != 1) {
            mudu_error_set(err, MUDU_EC_DOMAIN_VIOLATION, "delete item label failed");
            return -1;
        }
    }
    for (i = 0; i < info->labels.len; i++) {
        mudu_datum ins_args[3];
        ins_args[0] = mudu_i64(item_id);
        ins_args[1] = mudu_i64((int64_t)i);
        ins_args[2] = mudu_str(info->labels.items[i].data, info->labels.items[i].len);
        if (mudu_command(session,
                         "INSERT INTO item_info_labels (item_id, idx, label) VALUES (?, ?, ?)",
                         ins_args, 3, &affected, err)
            != 0) {
            return -1;
        }
        if (affected != 1) {
            mudu_error_set(err, MUDU_EC_DOMAIN_VIOLATION, "insert item label failed");
            return -1;
        }
    }
    return 0;
}

/* The engine has no ORDER BY: insertion-sort the side-table rows in place
 * by their i64 key field. */
static void sort_rows_by_i64_key(mudu_rows *rows, uint32_t key_field) {
    uint32_t i;
    for (i = 1; i < rows->n_rows; i++) {
        mudu_row key = rows->rows[i];
        int64_t key_value = key.fields[key_field].i64;
        uint32_t j = i;
        while (j > 0 && rows->rows[j - 1].fields[key_field].i64 > key_value) {
            rows->rows[j] = rows->rows[j - 1];
            j--;
        }
        rows->rows[j] = key;
    }
}

/* Rebuild the stored item-info record: the flat columns and the side-table
 * labels re-sorted by idx. The slices the record borrows point into the
 * query decode arena, which lives in the guest arena until the call ends —
 * the same lifetime the result encode needs. */
static int query_item_info(mudu_oid session, int64_t item_id, item_info *out, mudu_error *err) {
    mudu_datum args[1];
    mudu_rows rows;
    mudu_rows label_rows;
    uint32_t i;
    memset(out, 0, sizeof(*out));
    args[0] = mudu_i64(item_id);
    if (mudu_query(session, "SELECT name, price, in_stock FROM item_info WHERE item_id = ?",
                   args, 1, &rows, err)
        != 0) {
        return -1;
    }
    if (rows.n_rows == 0) {
        mudu_error_set(err, MUDU_EC_ENTITY_NOT_FOUND, "item info not found");
        return -1;
    }
    if (rows.rows[0].n_fields != 3) {
        mudu_error_set(err, MUDU_EC_INTERNAL, "item info row shape mismatch");
        return -1;
    }
    {
        mudu_datum *f = rows.rows[0].fields;
        if (f[0].kind != MUDU_DATUM_STR) {
            mudu_error_set(err, MUDU_EC_INTERNAL, "item info name is not a string");
            return -1;
        }
        if (f[1].kind != MUDU_DATUM_I64 || f[1].i64 < 0 || f[1].i64 > 4294967295LL) {
            mudu_error_set(err, MUDU_EC_INTERNAL, "item info price is not a u32");
            return -1;
        }
        if (f[2].kind != MUDU_DATUM_I64) {
            mudu_error_set(err, MUDU_EC_INTERNAL, "item info in_stock is not an i64");
            return -1;
        }
        out->name = mp_str_from(f[0].str, f[0].str_len);
        out->price = (uint32_t)f[1].i64;
        out->in_stock = f[2].i64 != 0;
    }

    args[0] = mudu_i64(item_id);
    if (mudu_query(session, "SELECT idx, label FROM item_info_labels WHERE item_id = ?", args, 1,
                   &label_rows, err)
        != 0) {
        return -1;
    }
    for (i = 0; i < label_rows.n_rows; i++) {
        if (label_rows.rows[i].n_fields != 2
            || label_rows.rows[i].fields[0].kind != MUDU_DATUM_I64
            || label_rows.rows[i].fields[1].kind != MUDU_DATUM_STR) {
            mudu_error_set(err, MUDU_EC_INTERNAL, "item label row shape mismatch");
            return -1;
        }
    }
    sort_rows_by_i64_key(&label_rows, 0);
    if (label_rows.n_rows) {
        mp_str *items =
            (mp_str *)mudu_arena_alloc((size_t)label_rows.n_rows * sizeof(mp_str), 8);
        if (!items) {
            mudu_error_set(err, MUDU_EC_INTERNAL, "out of memory");
            return -1;
        }
        for (i = 0; i < label_rows.n_rows; i++) {
            items[i] = mp_str_from(label_rows.rows[i].fields[1].str,
                                   label_rows.rows[i].fields[1].str_len);
        }
        out->labels.items = items;
        out->labels.len = label_rows.n_rows;
    }
    return 0;
}

/* update_item_info stores a user-defined record argument and returns the
 * stored record. The `item-info` record type is declared in wit/types.wit
 * and generated into gentypes/Types.h by mgen; the procedure decodes the
 * positional record envelope through the binding record bridge
 * (mp_record_bridge_write) composed with the generated item_info_decode,
 * and encodes the returned record symmetrically (item_info_encode +
 * mp_record_bridge_read). See store_item_info for the storage design. */
// mudu-proc (item_id: i64, info: ItemInfo) -> ItemInfo
int update_item_info(const mudu_proc_param *param, mudu_datum *result, mudu_error *err) {
    int64_t item_id = param->params[0].i64;
    item_info info;
    item_info stored;
    /* decode the record envelope: the bridge serializes it as the
     * integer-keyed MessagePack map the generated item_info_decode reads */
    {
        mp_writer w;
        mp_reader r;
        mp_arena a;
        mpw_init(&w);
        if (mp_record_bridge_write(param->params[1].record, &w) != 0) {
            mudu_error_set(err, MUDU_EC_INVALID_ARGUMENT, "item info record bridge failed");
            return -1;
        }
        mpr_init(&r, w.buf, (size_t)w.len);
        mpa_init(&a);
        if (item_info_decode(&r, &a, &info) != 0 || !mpr_done(&r)) {
            mudu_error_set(err, MUDU_EC_INVALID_ARGUMENT, "item info record decode failed");
            return -1;
        }
        mpw_free(&w);
    }
    if (store_item_info(param->session, item_id, &info, err) != 0) {
        return -1;
    }
    if (query_item_info(param->session, item_id, &stored, err) != 0) {
        return -1;
    }
    /* encode the stored record symmetrically: item_info_encode renders the
     * integer-keyed map and the bridge wraps it back into the record-case
     * envelope the host expects (arena-owned — outlives this frame, which
     * is what the deferred result encode in mudu_run_proc needs) */
    {
        mp_writer w;
        mp_reader r;
        mp_arena a;
        uni_data_value *envelope;
        mpw_init(&w);
        item_info_encode(&w, &stored);
        if (!mpw_ok(&w)) {
            mudu_error_set(err, MUDU_EC_INTERNAL, "item info encode failed");
            return -1;
        }
        mpr_init(&r, w.buf, (size_t)w.len);
        mpa_init(&a);
        envelope = (uni_data_value *)mpa_alloc(&a, sizeof(uni_data_value));
        if (!envelope) {
            mudu_error_set(err, MUDU_EC_INTERNAL, "out of memory");
            return -1;
        }
        if (mp_record_bridge_read(&r, &a, envelope) != 0 || !mpr_done(&r)) {
            mudu_error_set(err, MUDU_EC_INTERNAL, "item info record bridge read failed");
            return -1;
        }
        mpw_free(&w);
        *result = mudu_record(envelope);
    }
    return 0;
}
