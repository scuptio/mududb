impl {{ table.change_struct_name }} {
    pub fn is_empty(&self) -> bool {
{% for field in table.update_fields() %}
{% if loop.first %}
        self.{{ field.field_name_snake_case }}.is_unchanged()
{% else %}
            && self.{{ field.field_name_snake_case }}.is_unchanged()
{% endif %}
{% endfor %}
    }

    /// Builds the `UPDATE {{ table.entity_name }} SET ... WHERE {{ table.pk_predicate }}`
    /// statement and its bind parameters (primary key last). Returns `None`
    /// when no column is marked for update.
    pub fn update_by_pk(
        &self,
{% for field in table.pk_fields() %}
        {{ field.field_name_snake_case }}: {{ field.data_type }},
{% endfor %}
    ) -> Option<(String, Vec<Box<dyn DatumDyn>>)> {
        let mut sets = Vec::new();
        let mut params: Vec<Box<dyn DatumDyn>> = Vec::new();
{% for field in table.update_fields() %}
        if let FieldChange::Set(value) = &self.{{ field.field_name_snake_case }} {
            sets.push([columns::{{ field.field_name_const }}, " = ?"].concat());
            params.push(Box::new({% if field.is_copy %}*value{% else %}value.clone(){% endif %}));
        }
{% endfor %}
        if sets.is_empty() {
            return None;
        }
{% for field in table.pk_fields() %}
        params.push(Box::new({{ field.field_name_snake_case }}));
{% endfor %}
        let sql = [
            "UPDATE ",
            TABLE_NAME,
            " SET ",
            &sets.join(", "),
            " WHERE ",
            "{{ table.pk_predicate }}",
        ]
        .concat();
        Some((sql, params))
    }
}
