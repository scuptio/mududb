/// Length in bytes of the fixed syscall payload header.
pub const HEADER_LEN: usize = 16;

const MAGIC: u32 = 0x4D53_5350;
const VERSION: u32 = 1;

/// Syscall message kinds carried in the header's `message_kind` field.
///
/// The discriminants identify the WIT functions of this file and are pinned
/// to their 1-based declaration order; `0` and unknown values are rejected by
/// [`decode_header`].
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[repr(u32)]
pub enum MessageKind {
    {% for kind in kinds %}
    {% if kind.comment.len() > 0 %}
    {{ kind.comment }}
    {% endif %}
    {{ kind.case_name }} = {{ kind.discriminant }},
    {% endfor %}
}

impl MessageKind {
    /// Convert a raw header value into a message kind.
    pub fn from_u32(raw: u32) -> Option<MessageKind> {
        match raw {
            {% for kind in kinds %}
            {{ kind.discriminant }} => Some(MessageKind::{{ kind.case_name }}),
            {% endfor %}
            _ => None,
        }
    }

    /// The raw header value of this message kind.
    pub fn to_u32(self) -> u32 {
        self as u32
    }
}

/// Protocol-level decode failure (bad magic, unsupported version, nonzero
/// flags, unknown or mismatched message kind, malformed or trailing body
/// bytes). Business errors carried by a result frame are values of the
/// [`UniResult`] type, not this error.
#[derive(Debug, Clone)]
pub struct SyscallFrameError {
    /// Human-readable description of the violation.
    pub message: String,
}

impl SyscallFrameError {
    fn new(message: impl Into<String>) -> Self {
        Self {
            message: message.into(),
        }
    }
}

impl std::fmt::Display for SyscallFrameError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "{}", self.message)
    }
}

impl std::error::Error for SyscallFrameError {}

/// Wire-level `result<T, E>` exchanged with the peer: `Ok(value)` encodes as
/// `[0u8, value]` and `Err(error)` as `[1u8, error]`.
pub type UniResult<T> = Result<T, {{ err_type_name }}>;

/// Encodes the fixed 16-byte header for `kind`.
pub fn encode_header(kind: MessageKind) -> [u8; HEADER_LEN] {
    let mut out = [0u8; HEADER_LEN];
    out[0..4].copy_from_slice(&MAGIC.to_be_bytes());
    out[4..8].copy_from_slice(&VERSION.to_be_bytes());
    // flags at out[8..12] stay zero.
    out[12..16].copy_from_slice(&kind.to_u32().to_be_bytes());
    out
}

/// Decodes and validates the fixed 16-byte header, returning the message kind.
pub fn decode_header(input: &[u8]) -> Result<MessageKind, SyscallFrameError> {
    if input.len() < HEADER_LEN {
        return Err(SyscallFrameError::new(format!(
            "header shorter than {} bytes ({})",
            HEADER_LEN,
            input.len()
        )));
    }
    let magic = be_u32(input, 0);
    if magic != MAGIC {
        return Err(SyscallFrameError::new(format!(
            "bad magic {magic:#010x}, expected {MAGIC:#010x}"
        )));
    }
    let version = be_u32(input, 4);
    if version != VERSION {
        return Err(SyscallFrameError::new(format!(
            "unsupported payload version {version}, supported range is [1, 1]"
        )));
    }
    let flags = be_u32(input, 8);
    if flags != 0 {
        return Err(SyscallFrameError::new(format!(
            "nonzero header flags {flags:#x}"
        )));
    }
    let kind_raw = be_u32(input, 12);
    MessageKind::from_u32(kind_raw)
        .ok_or_else(|| SyscallFrameError::new(format!("unknown syscall message kind {kind_raw}")))
}

/// Encodes a complete frame: the 16-byte header followed by `body`.
pub fn encode_frame(kind: MessageKind, body: &[u8]) -> Vec<u8> {
    let mut out = Vec::with_capacity(HEADER_LEN + body.len());
    out.extend_from_slice(&encode_header(kind));
    out.extend_from_slice(body);
    out
}

/// Splits a frame into its validated message kind and the borrowed body slice.
pub fn decode_frame(input: &[u8]) -> Result<(MessageKind, &[u8]), SyscallFrameError> {
    let kind = decode_header(input)?;
    Ok((kind, &input[HEADER_LEN..]))
}

/// Reads a big-endian `u32` at `offset`; `input` must be at least `offset + 4`
/// bytes long (guaranteed by the [`HEADER_LEN`] check).
fn be_u32(input: &[u8], offset: usize) -> u32 {
    let mut bytes = [0u8; 4];
    bytes.copy_from_slice(&input[offset..offset + 4]);
    u32::from_be_bytes(bytes)
}

/// Serializes a single wire value into a MessagePack body (canonical form).
fn encode_body(value: &Value) -> Vec<u8> {
    crate::universal::mp_wire::encode_value(value)
}

/// Parses a MessagePack body into a wire value, requiring the whole body to
/// be consumed (trailing bytes are rejected).
fn decode_body(body: &[u8]) -> Result<Value, SyscallFrameError> {
    crate::universal::mp_wire::decode_value(body).map_err(wire_error_to_frame)
}

/// Maps a wire-runtime error to a protocol-level frame error.
fn wire_error_to_frame(error: WireError) -> SyscallFrameError {
    SyscallFrameError::new(error.message)
}

/// Validates a frame and checks it carries the expected message kind,
/// returning the borrowed body.
fn decode_typed_frame(expected: MessageKind, frame: &[u8]) -> Result<&[u8], SyscallFrameError> {
    let (kind, body) = decode_frame(frame)?;
    if kind != expected {
        return Err(SyscallFrameError::new(format!(
            "unexpected syscall message kind {}, expected {}",
            kind.to_u32(),
            expected.to_u32()
        )));
    }
    Ok(body)
}

/// Encodes a request frame whose body is the integer-keyed MessagePack map of
/// the WIT-declared arguments (1-based parameter numbers).
fn encode_request_frame(kind: MessageKind, body: Value) -> Vec<u8> {
    encode_frame(kind, &encode_body(&body))
}

/// Decodes a request frame into its argument map: a list of `(number, value)`
/// pairs. Non-integer keys are skipped (they cannot be WIT parameters).
fn decode_request_map(
    kind: MessageKind,
    frame: &[u8],
) -> Result<Vec<(u64, Value)>, SyscallFrameError> {
    let body = decode_typed_frame(kind, frame)?;
    match decode_body(body)? {
        Value::Map(pairs) => {
            let mut fields = Vec::with_capacity(pairs.len());
            for (key, value) in pairs {
                if let Ok(number) = key.as_u64() {
                    fields.push((number, value));
                }
            }
            Ok(fields)
        }
        other => Err(SyscallFrameError::new(format!(
            "request body must be an integer-keyed map, found {other:?}"
        ))),
    }
}

/// Decodes one argument by its 1-based number; a missing key decodes as the
/// type default (proto3 semantics), an unknown key is ignored by the caller.
fn decode_field<T: Default>(
    fields: &[(u64, Value)],
    number: u64,
    decode: impl FnOnce(&Value) -> Result<T, WireError>,
) -> Result<T, SyscallFrameError> {
    match fields.iter().find(|(key, _)| *key == number) {
        Some((_, value)) => decode(value).map_err(wire_error_to_frame),
        None => Ok(T::default()),
    }
}

/// Encodes a result frame whose body is `[0u8, value]` / `[1u8, error]`.
fn encode_result_frame(kind: MessageKind, result: UniResult<Value>) -> Vec<u8> {
    let body = match result {
        Ok(value) => Value::Array(vec![Value::from(0u8), value]),
        Err(error) => Value::Array(vec![Value::from(1u8), error.to_value()]),
    };
    encode_frame(kind, &encode_body(&body))
}

/// Encodes a unit result frame whose body is `[0u8, 0u8]` / `[1u8, error]`.
fn encode_unit_result_frame(kind: MessageKind, result: &UniResult<()>) -> Vec<u8> {
    let body = match result {
        Ok(()) => Value::Array(vec![Value::from(0u8), Value::from(0u8)]),
        Err(error) => Value::Array(vec![Value::from(1u8), error.to_value()]),
    };
    encode_frame(kind, &encode_body(&body))
}

/// Decodes a result frame into the success value or the carried error.
fn decode_result_frame(
    kind: MessageKind,
    frame: &[u8],
) -> Result<UniResult<Value>, SyscallFrameError> {
    let body = decode_typed_frame(kind, frame)?;
    let value = decode_body(body)?;
    let items = value.as_array().map_err(wire_error_to_frame)?;
    if items.len() != 2 {
        return Err(SyscallFrameError::new(format!(
            "result body must be a 2-element [ok_tag, value] array, found {} elements",
            items.len()
        )));
    }
    let tag = u32::from_value(&items[0]).map_err(wire_error_to_frame)?;
    match tag {
        0 => Ok(Ok(items[1].clone())),
        1 => Ok(Err(
            {{ err_type_name }}::from_value(&items[1]).map_err(wire_error_to_frame)?,
        )),
        _ => Err(SyscallFrameError::new(format!(
            "unknown result tag {tag}, expected 0u8 or 1u8"
        ))),
    }
}

/// Decodes a unit result frame.
fn decode_unit_result_frame(
    kind: MessageKind,
    frame: &[u8],
) -> Result<UniResult<()>, SyscallFrameError> {
    match decode_result_frame(kind, frame)? {
        Ok(_) => Ok(Ok(())),
        Err(error) => Ok(Err(error)),
    }
}

/// Maps the success arm of a result, cloning the error arm.
fn map_result_ref<'a, T, U, F>(result: &'a UniResult<T>, map: F) -> UniResult<U>
where
    F: FnOnce(&'a T) -> U,
{
    match result {
        Ok(value) => Ok(map(value)),
        Err(error) => Err(error.clone()),
    }
}
