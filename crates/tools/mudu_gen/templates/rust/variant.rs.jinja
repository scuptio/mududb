{% if cfg.impl_default %}
impl Default for {{ variant.variant_name }} {
    fn default() -> Self {
        {% if variant.variant_cases[0].vc_has_inner_type %}
        Self::{{ variant.variant_cases[0].vc_case_name }} (Default::default())
