    const error = result.error;
    if (error !== null) {
        writer.writeU64(1);
        {{ func.err_type_name }}Codec.encode(error!, writer);
    } else {
        // unit success: the `0u8` placeholder payload
        writer.writeU64(0);
        writer.writeU64(0);
    }
    return encodeFrame(MessageKind.{{ func.kind_case }}, writer.toBytes());
}

export function decode{{ func.pascal }}Result(frame: Uint8Array): {{ func.res_holder_name }} {
    const reader = new MpackReader(expectFrameBody(frame, MessageKind.{{ func.kind_case }}));
    const count = reader.readArrayHeader();
    if (count !== 2) {
        throw new Error(`Expected array of length 2, got ${count}`);
    }
    const tag = reader.readU64() as u8;
    if (tag === 0) {
        // consume the `0u8` placeholder payload
        reader.readU64();
        if (!reader.isDone()) {
            throw new Error("trailing bytes after syscall payload body");
        }
        return new {{ func.res_holder_name }}();
    }
    if (tag === 1) {
        const result = {{ func.res_holder_name }}.err({{ func.err_type_name }}Codec.decode(reader));
        if (!reader.isDone()) {
            throw new Error("trailing bytes after syscall payload body");
        }
        return result;
    }
    throw new Error(`MSSP unknown result tag ${tag}, expected 0 (ok) or 1 (err)`);
}
