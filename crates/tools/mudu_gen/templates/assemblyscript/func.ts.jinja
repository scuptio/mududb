        return result;
    }
    {% endif %}

    static err(error: {{ func.err_type_name }}): {{ func.res_holder_name }} {
        const result = new {{ func.res_holder_name }}();
        result.error = error;
        return result;
    }

    get isOk(): bool {
        return this.error === null;
    }
}

