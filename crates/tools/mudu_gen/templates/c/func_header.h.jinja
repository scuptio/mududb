/* Length in bytes of the fixed MSSP payload header. */
#define {{ macro_prefix }}_MSSP_HEADER_LEN 16u

/* Syscall message kinds carried in the header's `message_kind` field. The
 * discriminants identify the WIT functions of this file and are pinned to
 * their 1-based declaration order; `0` and unknown values are rejected by
 * `{{ prefix }}_decode_header`. */
typedef enum {
{%- for kind in kinds %}
{%- if kind.comment.len() > 0 %}
    {{ kind.comment }}
{%- endif %}
    {{ kind.const_name }} = {{ kind.discriminant }}u,
{%- endfor %}
} {{ prefix }}_message_kind;

/* Convert a raw header value into a message kind; -1 on `0` and unknown
 * values. */
MP_INLINE int {{ prefix }}_message_kind_from_u32(uint32_t raw, {{ prefix }}_message_kind *out) {
    switch (raw) {
{%- for kind in kinds %}
    case {{ kind.discriminant }}u:
        *out = {{ kind.const_name }};
        return 0;
{%- endfor %}
    default:
        return -1;
    }
}

/* Append the fixed 16-byte header for `kind` to `w` (magic "MSSP",
 * version 1, zero flags; all header fields big-endian). */
MP_INLINE void {{ prefix }}_write_header(mp_writer *w, {{ prefix }}_message_kind kind) {
    uint8_t header[{{ macro_prefix }}_MSSP_HEADER_LEN];
    uint32_t raw = (uint32_t)kind;
    memset(header, 0, sizeof(header));
    header[0] = 0x4du; /* 'M' */
    header[1] = 0x53u; /* 'S' */
    header[2] = 0x53u; /* 'S' */
    header[3] = 0x50u; /* 'P' */
    header[7] = 1u;    /* version 1 (big-endian u32) */
    header[12] = (uint8_t)(raw >> 24);
    header[13] = (uint8_t)(raw >> 16);
    header[14] = (uint8_t)(raw >> 8);
    header[15] = (uint8_t)raw;
    mpw_raw(w, header, sizeof(header));
}

/* Read and validate the fixed 16-byte header, returning the message kind in
 * `out`; -1 (with the reader's sticky error set) on any integrity
 * violation. */
MP_INLINE int {{ prefix }}_decode_header(mp_reader *r, {{ prefix }}_message_kind *out) {
    uint8_t header[{{ macro_prefix }}_MSSP_HEADER_LEN];
    uint32_t magic;
    uint32_t version;
    uint32_t flags;
    uint32_t raw;
    if (mpr_raw(r, header, sizeof(header)) != 0) {
        return -1;
    }
    magic = ((uint32_t)header[0] << 24) | ((uint32_t)header[1] << 16)
        | ((uint32_t)header[2] << 8) | (uint32_t)header[3];
    if (magic != 0x4d535350u) {
        mpr_fail(r);
        return -1;
    }
    version = ((uint32_t)header[4] << 24) | ((uint32_t)header[5] << 16)
        | ((uint32_t)header[6] << 8) | (uint32_t)header[7];
    if (version != 1u) {
        mpr_fail(r);
        return -1;
    }
    flags = ((uint32_t)header[8] << 24) | ((uint32_t)header[9] << 16)
        | ((uint32_t)header[10] << 8) | (uint32_t)header[11];
    if (flags != 0u) {
        mpr_fail(r);
        return -1;
    }
    raw = ((uint32_t)header[12] << 24) | ((uint32_t)header[13] << 16)
        | ((uint32_t)header[14] << 8) | (uint32_t)header[15];
    if ({{ prefix }}_message_kind_from_u32(raw, out) != 0) {
        mpr_fail(r);
        return -1;
    }
    return 0;
}
